{
  "name": "my-own-git",
  "version": "0.1.0",
  "description": "A fully functional Git implementation built from scratch in TypeScript",
  "type": "module",
  "bin": {
    "mygit": "./dist/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alireza-abdii/my-own-git.git"
  },
  "bugs": {
    "url": "https://github.com/alireza-abdii/my-own-git/issues"
  },
  "homepage": "https://github.com/alireza-abdii/my-own-git#readme",
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc",
    "prepack": "npm run build",
    "mygit": "tsx src/index.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
